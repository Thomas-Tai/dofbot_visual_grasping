<?xml version="1.0" encoding="utf-8"?>
<robot name="dofbot">
    <!-- ============== BASE LINK ============== -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/base_link.STL"/>
            </geometry>
            <material name="grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/base_link.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.032" rpy="0 0 0"/>
            <mass value="0.5"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <!-- ============== LINK 1 ============== -->
    <link name="link1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link1.STL"/>
            </geometry>
            <material name="green">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link1.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="joint1" type="revolute">
        <origin xyz="0 0 0.064" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="link1"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
    </joint>

    <!-- ============== LINK 2 ============== -->
    <link name="link2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link2.STL"/>
            </geometry>
            <material name="silver">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link2.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.04 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="joint2" type="revolute">
        <origin xyz="0 0 0.0435" rpy="0 1.5708 0"/>
        <parent link="link1"/>
        <child link="link2"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
    </joint>

    <!-- ============== LINK 3 ============== -->
    <link name="link3">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link3.STL"/>
            </geometry>
            <material name="green">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link3.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.04 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="joint3" type="revolute">
        <origin xyz="-0.08285 0 0" rpy="0 0 0"/>
        <parent link="link2"/>
        <child link="link3"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
    </joint>

    <!-- ============== LINK 4 ============== -->
    <link name="link4">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link4.STL"/>
            </geometry>
            <material name="silver">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link4.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="-0.04 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>
    <joint name="joint4" type="revolute">
        <origin xyz="-0.08285 0 0" rpy="0 0 0"/>
        <parent link="link3"/>
        <child link="link4"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="100" velocity="1"/>
    </joint>

    <!-- ============== LINK 5 (GRIPPER BASE) ============== -->
    <link name="link5">
        <visual>
            <origin xyz="0 0 -0.11" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link5.STL"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 -0.11" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://dofbot_description/meshes/link5.STL"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 -0.05" rpy="0 0 0"/>
            <mass value="0.05"/>
            <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
        </inertial>
    </link>
    <joint name="joint5" type="revolute">
        <origin xyz="-0.18385 -0.00215 -0.000605" rpy="0 -1.5708 0"/>
        <parent link="link4"/>
        <child link="link5"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="3.1416" effort="100" velocity="1"/>
    </joint>

    <!-- ============== TOOL0 (END-EFFECTOR FRAME) ============== -->
    <!-- This is the reference frame for MoveIt2 end-effector planning -->
    <link name="tool0"/>
    <joint name="tool0_joint" type="fixed">
        <origin xyz="0 0 -0.12" rpy="0 0 0"/>
        <parent link="link5"/>
        <child link="tool0"/>
    </joint>
</robot>